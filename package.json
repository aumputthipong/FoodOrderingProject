{
  "name": "canteen-ordering",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.12.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @canteen/api dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @canteen/api db:generate",
    "db:migrate": "pnpm --filter @canteen/api db:migrate",
    "db:seed": "pnpm --filter @canteen/api db:seed",
    "db:reset": "pnpm --filter @canteen/api db:reset"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
